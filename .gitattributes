# Golden files are byte-exact fixtures: the test compares the serializer's
# output to them literally, so any line-ending translation on checkout makes
# them fail on that platform alone. Windows checkouts convert LF to CRLF by
# default, which is invisible in a diff and produced exactly that failure.
internal/emit/testdata/golden/*.json -text

# Model fixtures are binary; never translate them.
testdata/*.gguf  binary
testdata/*.onnx  binary
testdata/*.safetensors binary

# Inspector fixtures are hostile binaries by design — pickles carrying real
# opcode sequences. Line-ending translation on a Windows checkout corrupts them
# into something the parser no longer recognises, so the detection tests fail
# there and only there, with output that looks like a parser bug rather than a
# checkout one.
internal/inspect/testdata/** binary
